OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=deepseek-chat

# ===== Embedding (RAG 向量检索，重要) =====
# 若 OPENAI_BASE_URL 指向的服务商没有 embedding API（如 DeepSeek），
# RAG 功能（向量检索/研究wiki）会自动降级为不可用（主流程仍可运行）。
# 推荐用硅基流动的 bge 模型启用完整 RAG：
#   EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
#   EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
#   EMBEDDING_API_KEY=sk-your-siliconflow-key
# 若 OPENAI_BASE_URL 是 OpenAI 或其它支持 text-embedding-3-small 的服务商，可留空。
EMBEDDING_MODEL=
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
# 跳过向量化入库 (=1 时 pdf_ingestion 只下载 PDF、不解析不 embedding，大幅提速)。
# 向量化是可选 RAG 增强（原文证据映射），跳过不影响论文撰写/审阅主流程。
SKIP_EMBEDDING=0
# 单篇论文全文摄入最大字符数 (越小块越少、embedding 越快)
PDF_FULLTEXT_MAX_CHARS=20000

# ===== 跨模型审阅（可选，推荐开启）=====
# 审阅节点使用独立模型，避免与撰写模型共享认知框架
# 例: REVIEWER_MODEL=Qwen/Qwen2.5-7B-Instruct  REVIEWER_API_KEY=sk-xxx  REVIEWER_BASE_URL=https://api.siliconflow.cn/v1
REVIEWER_MODEL=
REVIEWER_API_KEY=
REVIEWER_BASE_URL=
REVIEWER_TEMPERATURE=0.1

# ===== 廉价模型分层（可选，推荐开启）=====
# 子查询生成/相关性打分/引文 LLM 意见等轻量任务用廉价模型摊薄成本，
# 写作/大纲/审阅仍用主模型（OPENAI_MODEL）或 REVIEWER_MODEL。
# 留空则回退到主模型。
# 例: CHEAP_MODEL=deepseek-chat  CHEAP_BASE_URL=https://api.deepseek.com
CHEAP_MODEL=
CHEAP_BASE_URL=
CHEAP_API_KEY=

# ===== GROBID 结构化解析（可选）=====
# 本地: docker run -t -p 8070:8070 lfoppiano/grobid:0.8.0  → GROBID_BASE_URL=http://localhost:8070
# 或使用公共实例: https://grobid.aphia.org (已实测可用, 结构化解析: 摘要/章节/参考文献分离)
# 留空则使用 PyMuPDF 纯文本解析
GROBID_BASE_URL=

# ===== Langfuse 追踪（可选）=====
# 新版 (langfuse>=4.x): 只需一个 API key, 在 https://cloud.langfuse.com 注册获取
LANGFUSE_API_KEY=
# 旧版 (langfuse<4.x) 配置方式:
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ===== 中文文献源（可选）=====
# CNKI 开放平台: https://open.cnki.net 免费注册获取 key
CNKI_API_KEY=
# 万方开放平台: https://open.wanfangdata.com.cn 免费注册获取 key
WANFANG_API_KEY=

# ===== 检索与流程 =====
ARXIV_SEARCH_MAX_RESULTS=50
SEMANTIC_SCHOLAR_MAX_RESULTS=50
MAX_REVISIONS=3
REVIEW_ACCEPT_THRESHOLD=80
# 收敛检测: 连续 N 轮评分无提升则提前终止修订循环
STAGNATION_LIMIT=2
CROSSREF_EMAIL=
# PDF 下载上限: pdf_ingestion 阶段最多下载多少篇全文 (每篇间隔 3s 限流)。
# 调试全流程时调低可显著提速 (如 5~10); 正式运行调回 30。
PDF_DOWNLOAD_LIMIT=30
# OpenAlex 2025 起按用量计费, 免费层日预算耗尽返回 429 (UTC 午夜重置)。
# 注册 https://openalex.org 获取 API key 获得礼貌池更高额度。
OPENALEX_API_KEY=

# ===== 网络容错配置 =====
# 超时分离 (秒): connect=建立连接, read=等待响应, write=发送数据
HTTP_CONNECT_TIMEOUT=10
HTTP_READ_TIMEOUT=30
HTTP_WRITE_TIMEOUT=30
# 最大重试次数 (3 = 首次 + 2 次重试)
HTTP_MAX_RETRIES=3

# ===== LLM 调用超时 =====
# 推理模型审稿/写作耗时长, 默认 900s; 单次超时后自动重试 LLM_MAX_RETRIES 次
LLM_TIMEOUT=900
LLM_MAX_RETRIES=2
# 退避基值: 公式 base * 2^attempt (attempt 从 0 开始)
# 网络错误: 2*1=2s → 2*2=4s → 2*4=8s
HTTP_BACKOFF_BASE=2
# 429 限流: 4*1=4s → 4*2=8s → 4*4=16s (速率窗口通常 30s+, 短间隔重试无意义)
HTTP_429_BACKOFF_BASE=4
# 断路器：连续失败 N 次后暂停请求 M 秒
HTTP_CIRCUIT_BREAKER_THRESHOLD=5
HTTP_CIRCUIT_BREAKER_COOLDOWN=60
