OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=deepseek-chat

# ===== Embedding (RAG 向量检索，重要) =====
# 若 OPENAI_BASE_URL 指向的服务商没有 embedding API（如 DeepSeek），
# RAG 功能（向量检索/研究wiki）会自动降级为不可用（主流程仍可运行）。
# 推荐用硅基流动的 bge 模型启用完整 RAG：
#   EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
#   EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
#   EMBEDDING_API_KEY=sk-your-siliconflow-key
# 若 OPENAI_BASE_URL 是 OpenAI 或其它支持 text-embedding-3-small 的服务商，可留空。
EMBEDDING_MODEL=
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=

# ===== 跨模型审阅（可选，推荐开启）=====
# 审阅节点使用独立模型，避免与撰写模型共享认知框架
# 例: REVIEWER_MODEL=Qwen/Qwen2.5-7B-Instruct  REVIEWER_API_KEY=sk-xxx  REVIEWER_BASE_URL=https://api.siliconflow.cn/v1
REVIEWER_MODEL=
REVIEWER_API_KEY=
REVIEWER_BASE_URL=
REVIEWER_TEMPERATURE=0.1

# ===== GROBID 结构化解析（可选）=====
# 本地: docker run -t -p 8070:8070 lfoppiano/grobid:0.8.0  → GROBID_BASE_URL=http://localhost:8070
# 或使用公共实例: https://grobid.aphia.org (已实测可用, 结构化解析: 摘要/章节/参考文献分离)
# 留空则使用 PyMuPDF 纯文本解析
GROBID_BASE_URL=

# ===== Langfuse 追踪（可选）=====
# 新版 (langfuse>=4.x): 只需一个 API key, 在 https://cloud.langfuse.com 注册获取
LANGFUSE_API_KEY=
# 旧版 (langfuse<4.x) 配置方式:
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ===== 检索与流程 =====
ARXIV_SEARCH_MAX_RESULTS=50
SEMANTIC_SCHOLAR_MAX_RESULTS=50
MAX_REVISIONS=3
REVIEW_ACCEPT_THRESHOLD=75
CROSSREF_EMAIL=
