#!/bin/sh
# 推送守卫：evals/reports/ 下的审查报告只提交到本地，不进入远端历史。
#
# 启用（仓库本地配置，不随仓库分发）：
#   git config --local core.hooksPath .githooks
#
# 报告与代码都在 master 上时直接 git push 会把报告一起推上去，因此拦截并指向
# scripts/push_code.ps1（它只推代码类提交，报告留在本地）。

zero=$(printf '%0.40s' 0)
status=0

while read -r local_ref local_sha remote_ref remote_sha; do
    case "$remote_ref" in
        refs/heads/*) ;;
        *) continue ;;
    esac
    [ "$local_sha" = "$zero" ] && continue
    [ "$local_ref" = "(delete)" ] && continue

    if [ "$remote_sha" = "$zero" ]; then
        range="$local_sha"
    else
        range="$remote_sha..$local_sha"
    fi

    hits=$(git rev-list "$range" -- evals/reports 2>/dev/null | head -n 5)
    if [ -n "$hits" ]; then
        echo "pre-push 拒绝：这次推送包含 evals/reports/ 下的报告提交（口径：报告只留本地）。" >&2
        echo "$hits" | sed 's/^/  /' >&2
        echo "请改用：pwsh -File scripts/push_code.ps1" >&2
        status=1
    fi
done

exit $status
